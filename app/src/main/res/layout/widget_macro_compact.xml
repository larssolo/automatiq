<?xml version="1.0" encoding="utf-8"?>
<!-- 1×1 macro button: a coloured round button with the macro's name underneath, like an app icon. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:padding="2dp">

    <FrameLayout android:layout_width="40dp" android:layout_height="40dp">
        <ImageView android:id="@+id/widget_compact_bg"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/widget_compact_background"
            android:contentDescription="@null" />
        <ImageView android:id="@+id/widget_compact_icon"
            android:layout_width="18dp" android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_send"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView android:id="@+id/widget_compact_name"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2" android:ellipsize="end" android:gravity="center"
        android:textColor="#FFFFFF" android:textSize="11sp"
        android:shadowColor="#CC000000" android:shadowRadius="3" android:shadowDy="1"
        android:text="Macro" />
</LinearLayout>
